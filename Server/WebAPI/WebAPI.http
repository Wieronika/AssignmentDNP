@WebAPI_HostAddress = http://localhost:5120

### Test WeatherForecast
GET {{WebAPI_HostAddress}}/weatherforecast/
Accept: application/json

### Create a new user
POST {{WebAPI_HostAddress}}/users
Content-Type: application/json

{
  "userName": "Veronica",
  "password": "qwerty123"
}

### Get all users
GET {{WebAPI_HostAddress}}/users
Accept: application/json

### Update user
PATCH {{WebAPI_HostAddress}}/users/1
Content-Type: application/json

{
  "userName": "VeronicaCheckUpd",
  "password": "TEST123"
}

### Get user by ID
GET {{WebAPI_HostAddress}}/users/1
Accept: application/json

### Delete user
DELETE {{WebAPI_HostAddress}}/users/1

### Get a user that does not exist
GET {{WebAPI_HostAddress}}/users/9999
Accept: application/json





### Create a user/ author of the post
POST {{WebAPI_HostAddress}}/users
Content-Type: application/json

{
  "userName": "Veronica",
  "password": "qwerty123"
}

###Create a post
POST {{WebAPI_HostAddress}}/posts
Content-Type: application/json

{
  "title": "My first post",
  "body": "This is my first post.",
  "userId": 1
}

###  Get all posts
GET {{WebAPI_HostAddress}}/posts
Accept: application/json

### Get post by ID
GET {{WebAPI_HostAddress}}/posts/1
Accept: application/json

###  Get posts by user
GET {{WebAPI_HostAddress}}/posts?userId=1
Accept: application/json

### Update post
PATCH {{WebAPI_HostAddress}}/posts/1
Content-Type: application/json

{
  "title": "My updated post",
  "body": "Here is my updated Post"
}

###  Delete post
DELETE {{WebAPI_HostAddress}}/posts/1

### Test missing post
GET {{WebAPI_HostAddress}}/posts/9999
Accept: application/json







### Create a user
POST {{WebAPI_HostAddress}}/users
Content-Type: application/json

{
  "userName": "Veronica",
  "password": "qwerty123"
}

###  Create a post
POST {{WebAPI_HostAddress}}/posts
Content-Type: application/json

{
  "title": "Coffee discussion",
  "body": "What is your favourite coffee?",
  "userId": 1
}

### Create a comment
POST {{WebAPI_HostAddress}}/posts/1/comments
Content-Type: application/json

{
  "body": "I really like cappuccino!",
  "userId": 1
}

### Get comments for a post
GET {{WebAPI_HostAddress}}/posts/1/comments
Accept: application/json

###  Get comment by ID
GET {{WebAPI_HostAddress}}/comments/1
Accept: application/json

### Update a comment
PATCH {{WebAPI_HostAddress}}/comments/1
Content-Type: application/json

{
  "body": "Actually, my favourite is iced latte!"
}

### Delete a comment
DELETE {{WebAPI_HostAddress}}/comments/1

### Test missing comment
GET {{WebAPI_HostAddress}}/comments/9999
Accept: application/json



