
@using DnpBlazorClient.Auth
@using Microsoft.AspNetCore.Components.Authorization

@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            fora<span style="color: #ff9a45;">.</span>
        </a>
    </div>
</div>

<input type="checkbox"
       title="Navigation menu"
       class="navbar-toggler"/>

<div class="nav-scrollable"
     onclick="document.querySelector('.navbar-toggler').click()">

    <nav class="nav flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link"
                     href=""
                     Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu"
                      aria-hidden="true"></span>
                Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="posts">
                <span class="bi bi-list-nested-nav-menu"
                      aria-hidden="true"></span>
                Explore Posts
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="create-post">
                <span class="bi bi-plus-square-fill-nav-menu"
                      aria-hidden="true"></span>
                Create Post
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="create-user">
                <span class="bi bi-person-plus-fill-nav-menu"
                      aria-hidden="true"></span>
                Join Fora
            </NavLink>
        </div>
        
        <AuthorizeView>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        <span class="bi bi-person-circle"
                              aria-hidden="true"></span>
                        Log in
                    </NavLink>
                </div>
            </NotAuthorized>

            <Authorized>
                <div class="nav-item px-3">
                    <button type="button"
                            class="nav-link logout-button"
                            @onclick="LogoutAsync">
                        <span class="bi bi-box-arrow-right"
                              aria-hidden="true"></span>
                        Log out
                    </button>
                </div>
            </Authorized>
        </AuthorizeView>

    </nav>
</div>

@code {
    private async Task LogoutAsync()
    {
        //Clear the cached user using our SimpleAuthProvider
        await ((SimpleAuthProvider)AuthProvider).Logout();

        // return to the homepage after logging out
        Navigation.NavigateTo("/");
    }
}
